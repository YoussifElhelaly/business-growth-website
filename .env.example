ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
API_PORT=4001
COOKIE_NAME=bg_admin_session
NODE_ENV=development
# Optional: overrides the cookie's Secure flag regardless of NODE_ENV.
# Set to "false" for a production deployment served over plain HTTP (e.g. a LAN IP with no TLS).
# COOKIE_SECURE=false
# Optional: extra allowed CORS origins (comma-separated), beyond the built-in
# *.vercel.app pattern. Needed once a custom domain sits in front of the frontend.
# CORS_ORIGIN=https://example.com

# Frontend only (read by Vite, must be prefixed VITE_). Leave unset for local
# dev — requests stay same-origin via the vite.config.js proxy. Set this when
# the frontend is deployed separately from the backend (e.g. on Vercel) to the
# backend's public URL, with no trailing slash.
# VITE_API_BASE_URL=https://your-backend.example.com
